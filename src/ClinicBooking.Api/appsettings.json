{
  "ConnectionStrings": {
    "ClinicBooking": ""
  },
  "Jwt": {
    "Issuer": "ClinicBooking",
    "Audience": "ClinicBooking",
    "Key": "",
    "ExpiryMinutes": 120
  },
  "Clinic": {
    "TimeZone": "Africa/Johannesburg"
  },
  "Seed": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/clinic-booking-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
